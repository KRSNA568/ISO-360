    data: User[],
    total: number,
    page: number,
    pages: number
  }

PATCH /api/admin/users/:user_id/verify
  Body: {}
  Response: { success: true }

PATCH /api/admin/users/:user_id/block
  Body: { reason: string }
  Response: { success: true }

PATCH /api/admin/users/:user_id/unblock
  Response: { success: true }

DELETE /api/admin/users/:user_id
