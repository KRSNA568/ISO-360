## 4. Data Models

### 4.1 Canonical Schema (PostgreSQL)

```sql
-- users
CREATE TABLE users (
  id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  full_name     TEXT NOT NULL,
  email         TEXT UNIQUE NOT NULL,
  company       TEXT,
  role          TEXT,
  country       TEXT,
  email_verified BOOLEAN DEFAULT FALSE,
  created_at    TIMESTAMPTZ DEFAULT NOW(),
  deleted_at    TIMESTAMPTZ -- soft delete for GDPR right-to-erasure
);

-- otps
CREATE TABLE otps (
  id         UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id    UUID REFERENCES users(id) ON DELETE CASCADE,
  code       CHAR(6) NOT NULL,
  expires_at TIMESTAMPTZ NOT NULL,
  used       BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- exam_sessions
CREATE TABLE exam_sessions (
  id                    UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id               UUID REFERENCES users(id),
  track                 TEXT NOT NULL CHECK (track IN ('associate', 'professional')),
  status                TEXT NOT NULL DEFAULT 'generating'
                        CHECK (status IN ('generating','ready','active','completed','expired','aborted')),
  questions             JSONB NOT NULL DEFAULT '[]',  -- 50 question objects
  answers               JSONB NOT NULL DEFAULT '[]',  -- submitted answers
  score                 INTEGER,
  passed                BOOLEAN,
  tab_violations        INTEGER DEFAULT 0,
  ip_address            TEXT,
  user_agent            TEXT,
  device_fingerprint    TEXT,
  started_at            TIMESTAMPTZ,
  completed_at          TIMESTAMPTZ,
  expires_at            TIMESTAMPTZ,   -- started_at + 600s
  created_at            TIMESTAMPTZ DEFAULT NOW()
);

-- certificates
CREATE TABLE certificates (
  id               UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  certificate_id   TEXT UNIQUE NOT NULL, -- ISO27-2026-XXXXXXXX
  user_id          UUID REFERENCES users(id),
  exam_session_id  UUID REFERENCES exam_sessions(id),
  track            TEXT NOT NULL,
  full_name        TEXT NOT NULL,
  awarded_on       TIMESTAMPTZ NOT NULL,
  r2_url_landscape TEXT,   -- 1920x1080 JPEG
  r2_url_square    TEXT,   -- 1080x1080 JPEG
  revoked          BOOLEAN DEFAULT FALSE,
  revoked_reason   TEXT,
  created_at       TIMESTAMPTZ DEFAULT NOW()
);

-- question_fingerprints (overlap rule enforcement)
CREATE TABLE question_fingerprints (
  id             UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id        UUID REFERENCES users(id),
  track          TEXT NOT NULL,
  stem_hash      TEXT NOT NULL,   -- SHA-256 of question stem
  exam_session_id UUID REFERENCES exam_sessions(id),
  created_at     TIMESTAMPTZ DEFAULT NOW()
);
```

