{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test DOTENV_CONFIG_PATH=.env.test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write 'src/**/*.js'",
    "migrate": "node src/db/migrate.js",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testTimeout": 15000
  },
  "dependencies": {
    "@27001certified/shared": "*",
    "@supabase/supabase-js": "^2.98.0",
    "ajv": "^8.16.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.13",
    "openai": "^4.47.1",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "resend": "^3.2.0",
    "sharp": "^0.33.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^30.3.0",
    "nock": "^14.0.13",
    "nodemon": "^3.1.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  }
}
