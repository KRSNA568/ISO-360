PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/iso_audit360

# Redis (Upstash)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=your_refresh_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@iso-audit360.com

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=iso-audit360-certs
R2_PUBLIC_URL=https://certs.iso-audit360.com
