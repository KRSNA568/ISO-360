PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/27001certified

# Redis (Upstash — must be a rediss:// URL in production)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# JWT — must be ≥32 characters in production
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=change-me-to-a-different-random-32-plus-char-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Groq (AI report generation)
GROQ_API_KEY=gsk_...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@27001certified.in

# Supabase (certificate storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_CERT_BUCKET=certificates

# Sentry (optional — error tracking in production)
SENTRY_DSN=

# Exam retake overrides (optional)
RETAKE_MAX_ATTEMPTS=
RETAKE_WINDOW_DAYS=
